# =============================================================
# KamerCatch configuration
# Copy this file to ".env" and fill in the values you need.
# Everything has a safe default, so you can start with an empty
# .env file and KamerCatch will still run.
# =============================================================

# ---- Database -------------------------------------------------
# Where KamerCatch stores its data. Leave as-is unless you know
# you need a different location.
DATABASE_URL=file:/app/data/housing.db

# ---- Discord ---------------------------------------------------
# A webhook URL for quick text alerts (optional).
DISCORD_WEBHOOK_URL=

# A bot token for the review embeds with buttons (optional).
DISCORD_BOT_TOKEN=

# The Discord channel where the bot posts listings (optional).
DISCORD_CHANNEL_ID=

# ---- Platform logins ------------------------------------------
# Roomspot logs in with a USERNAME, not an email address.
ROOMSPOT_USERNAME=
ROOMSPOT_PASSWORD=

# Kamernet. Scraping works without these; they are only needed if
# you want to message landlords through Kamernet (which requires an
# active subscription).
KAMERNET_EMAIL=
KAMERNET_PASSWORD=

# ---- Tuning -----------------------------------------------------
# How often KamerCatch checks for new listings, in minutes.
SCRAPE_INTERVAL_MINUTES=15

# How many cycles in a row a scraper may return zero results before
# KamerCatch warns you that something may be broken.
ZERO_RESULT_ALERT_THRESHOLD=3

# How many pages each scraper reads per cycle.
ROOMSPOT_MAX_PAGES=3
MARKTPLAATS_MAX_PAGES=5
