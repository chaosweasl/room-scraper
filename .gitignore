# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
.next/
out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Scraper Data & Screenshots
data/
*.db
*.db-journal
error-screenshot.png

# Email Drafts (generated output)
email-drafts/

# Python
__pycache__/
*.pyc

# Kamernet session (sensitive — contains login cookies)
kamernet-session.json

# OS Files
Thumbs.db

# Developer Documents
/docs